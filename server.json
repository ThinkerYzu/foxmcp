{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ThinkerYzu/foxmcp",
  "title": "FoxMCP",
  "description": "Let your AI assistant use your real, logged-in Firefox: tabs, pages, bookmarks, history.",
  "repository": {
    "url": "https://github.com/ThinkerYzu/foxmcp",
    "source": "github"
  },
  "version": "1.7.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "foxmcp",
      "version": "1.7.0",
      "runtimeHint": "uvx",
      "packageArguments": [{"type": "positional", "value": "--stdio"}],
      "transport": {"type": "stdio"}
    }
  ]
}
