{
  "manifest_version": 2,
  "name": "FoxMCP",
  "version": "1.5.0",
  "description": "Browser extension that exposes data and functions to MCP clients via WebSocket",
  "author": "FoxMCP Project",
  "homepage_url": "https://github.com/ThinkerYzu/foxmcp",
  "permissions": [
    "contextualIdentities",
    "cookies",
    "tabs",
    "tabGroups",
    "menus",
    "clipboardWrite",
    "history",
    "bookmarks",
    "activeTab",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "FoxMCP",
    "default_icon": {
      "16": "icons/foxmcp-16.png",
      "32": "icons/foxmcp-32.png",
      "48": "icons/foxmcp-48.png",
      "64": "icons/foxmcp-64.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "foxmcp@codemud.org"
    }
  },
  "icons": {
    "16": "icons/foxmcp-16.png",
    "32": "icons/foxmcp-32.png",
    "48": "icons/foxmcp-48.png",
    "64": "icons/foxmcp-64.png",
    "96": "icons/foxmcp-96.png",
    "128": "icons/foxmcp-128.png",
    "256": "icons/foxmcp-256.png"
  }
}
